# Postgres (compose)
POSTGRES_USER=outline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=outline_manager
POSTGRES_PORT=5432

# Backend
APP_PORT=8080
CRON_INTERVAL=30m

# Directory served as the UI. Switch to ./frontend/dist once the React app is
# building.
FRONTEND_DIR=./frontend

# Comma-separated origins allowed to call the API cross-origin. Needed only
# when the frontend runs on its own host/port, e.g. the TanStack Start dev
# server:
# ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=

# This server's own public host[:port] (scheme optional, e.g.
# "vpn.example.com" or "https://vpn.example.com"). Set this to enable
# ssconf:// dynamic access key links — keys are then shared as a link that
# resolves through this server instead of a static ss:// key, so moving or
# rotating a key never requires redistributing a new link. Leave empty to
# keep sharing static ss:// links. See docs/ARCHITECTURE.md#8-dynamic-access-keys.
PUBLIC_BASE_URL=

# Auth
# The immutable super-admin. Can never be deleted, suspended, or demoted
# through the API regardless of who asks.
ROOT_ADMIN_EMAIL=minkgkyaw9899@gmail.com

# Required in production: signs session JWTs. If unset, a random secret is
# generated on each process start (fine for local dev; every restart
# invalidates existing sessions). Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=168h
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5

# Set to true once the app is served over HTTPS, so the auth cookie gets the
# Secure flag. Leave false for plain-HTTP local dev.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# SMTP (used to deliver the OTP login email). Gmail requires an App Password,
# not your normal account password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=minkgkyaw1999@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=minkgkyaw1999@gmail.com
SMTP_FROM_NAME=Outline VPN Manager
# Bounds the entire send (dial + handshake + auth + data) so a stalled
# connection fails fast instead of hanging the request.
SMTP_TIMEOUT=10s
