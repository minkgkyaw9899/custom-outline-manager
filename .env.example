# Postgres (compose)
POSTGRES_USER=outline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=outline_manager
POSTGRES_PORT=5432

# Backend
APP_PORT=8080
CRON_INTERVAL=30m

# Directory served as the UI. Switch to ./frontend/dist once the React app is
# building.
FRONTEND_DIR=./frontend

# Comma-separated origins allowed to call the API cross-origin. Needed only
# when the frontend runs on its own host/port, e.g. the TanStack Start dev
# server:
# ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=

# This server's own public host[:port] (scheme optional, e.g.
# "vpn.example.com" or "https://vpn.example.com"). Set this to enable
# ssconf:// dynamic access key links — keys are then shared as a link that
# resolves through this server instead of a static ss:// key, so moving or
# rotating a key never requires redistributing a new link. Leave empty to
# keep sharing static ss:// links. See docs/ARCHITECTURE.md#8-dynamic-access-keys.
PUBLIC_BASE_URL=

# Auth
# Required — the backend refuses to boot without it. The immutable
# super-admin. Can never be deleted, suspended, or demoted through the API
# regardless of who asks. Must match a seeded row in admin_users (see
# migration 0002_auth.up.sql) or first login has nothing to authenticate
# against.
ROOT_ADMIN_EMAIL=

# Required in production: signs session JWTs. If unset, a random secret is
# generated on each process start (fine for local dev; every restart
# invalidates existing sessions). Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=168h
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5

# Set to true once the app is served over HTTPS, so the auth cookie gets the
# Secure flag. Leave false for plain-HTTP local dev.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# SMTP (used to deliver the OTP login email). Gmail requires an App Password,
# not your normal account password: https://myaccount.google.com/apppasswords
# SMTP_USERNAME and SMTP_FROM_EMAIL are required — the backend refuses to
# boot without them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Outline VPN Manager
# Bounds the entire send (dial + handshake + auth + data) so a stalled
# connection fails fast instead of hanging the request.
SMTP_TIMEOUT=10s

# Telegram low-usage/near-expiry alerting. Entirely optional: leave
# TELEGRAM_BOT_TOKEN empty and the feature (cron sweep + webhook route) stays
# completely inert. Get a bot token from @BotFather. TELEGRAM_CHAT_ID is
# where alerts are posted (a channel id is negative, e.g. -1001234567890).
# TELEGRAM_ADMIN_USER_ID is the only Telegram user id whose button presses
# are honored. TELEGRAM_WEBHOOK_SECRET is any random string you choose; it's
# checked against Telegram's X-Telegram-Bot-Api-Secret-Token header so the
# public webhook route can't be forged. TELEGRAM_WEBHOOK_URL is this
# deployment's own public https URL to /api/v1/telegram/webhook — deliberately
# separate from PUBLIC_BASE_URL above, which points at a restricted host that
# only serves dynamic-access-key lookups. Leave TELEGRAM_WEBHOOK_URL empty to
# still send alerts without the interactive extend button.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
