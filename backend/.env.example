# Postgres (compose)
POSTGRES_USER=outline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=outline_manager

# Backend
CRON_INTERVAL=30m
HTTP_PORT=80

# The image nginx/api pull from GHCR — set by CI, or override to pin a tag.
BACKEND_IMAGE=ghcr.io/minkgkyaw9899/custom-outline-manager-backend:latest

# Comma-separated origins allowed to call the API cross-origin — the
# S3-hosted frontend's origin, e.g. https://app.example.com
ALLOWED_ORIGINS=

# This server's own public host[:port] (scheme optional, e.g.
# "vpn.example.com" or "https://vpn.example.com"). Set this to enable
# ssconf:// dynamic access key links — keys are then shared as a link that
# resolves through this server instead of a static ss:// key, so moving or
# rotating a key never requires redistributing a new link. Leave empty to
# keep sharing static ss:// links. See docs/ARCHITECTURE.md#8-dynamic-access-keys.
PUBLIC_BASE_URL=

# Auth
# The immutable super-admin. Can never be deleted, suspended, or demoted
# through the API regardless of who asks.
ROOT_ADMIN_EMAIL=minkgkyaw9899@gmail.com

# Required: signs session JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=168h
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5

# true once served over HTTPS, so the auth cookie gets the Secure flag.
COOKIE_SECURE=true
COOKIE_DOMAIN=

# SMTP (used to deliver the OTP login email). Gmail requires an App Password,
# not your normal account password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Outline VPN Manager
SMTP_TIMEOUT=10s
