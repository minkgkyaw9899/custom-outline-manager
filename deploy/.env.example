# Copy to .env in this directory on the Lightsail instance and fill in the
# blanks. This file never leaves the server — it is excluded from the CI
# deploy sync, unlike everything else in deploy/.

# Images pulled from GHCR by docker compose. Point these at :latest, or pin
# to a specific `sha-xxxxxxx` tag from a workflow run to roll back.
BACKEND_IMAGE=ghcr.io/minkgkyaw9899/custom-outline-manager-backend:latest
FRONTEND_IMAGE=ghcr.io/minkgkyaw9899/custom-outline-manager-frontend:latest

# Postgres
POSTGRES_USER=outline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=outline_manager

# Backend
CRON_INTERVAL=30m

# CORS: must be exactly the dashboard's origin (scheme + host, no path/slash).
ALLOWED_ORIGINS=https://light-speed.invisigate.asia

# Host the ssconf:// dynamic-access links point at — deliberately not the API
# domain (light-speed-api...) so a shared link never reveals it. No scheme.
PUBLIC_BASE_URL=dynamic-access-light-speed.invisigate.asia

ROOT_ADMIN_EMAIL=minkgkyaw9899@gmail.com

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=168h
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5

# Real HTTPS in front (nginx terminates TLS), so Secure must be true. Domain
# is the shared parent so the auth cookie set on the API's host is also sent
# from the dashboard's host (they're different subdomains = different CORS
# origins, but the same registrable/"site" domain, so this stays SameSite=Lax
# safe).
COOKIE_SECURE=true
COOKIE_DOMAIN=.invisigate.asia

# SMTP (OTP login email). Gmail requires an App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Invisigate VPN
SMTP_TIMEOUT=10s

# Used only by init-letsencrypt.sh, not by docker compose.
CERTBOT_EMAIL=minkgkyaw9899@gmail.com

# Telegram low-usage/near-expiry alerting. Leave TELEGRAM_BOT_TOKEN empty and
# the feature stays inert. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Where alerts are posted — a channel id is negative, e.g. -1001234567890.
TELEGRAM_CHAT_ID=
# The only Telegram user id whose "Extend" button presses are honored.
TELEGRAM_ADMIN_USER_ID=
# Any random string; checked against Telegram's
# X-Telegram-Bot-Api-Secret-Token header so the public webhook route can't be
# forged. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# This deployment's own public URL to the webhook route — the API domain
# above, not PUBLIC_BASE_URL (that one is deliberately restricted to
# dynamic-access-key lookups only).
TELEGRAM_WEBHOOK_URL=https://light-speed-api.invisigate.asia/api/v1/telegram/webhook
